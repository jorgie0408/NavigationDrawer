<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_utama"
    app:startDestination="@id/homeFragment">

    <!-- HOME -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.navigationdrawer.HomeFragment"
        android:label="Home"/>

    <!-- PROFILE -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.navigationdrawer.ProfileFragment"
        android:label="Profile">

        <action
            android:id="@+id/action_profileFragment_to_detailProfileFragment"
            app:destination="@id/detailProfileFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out"
            app:popEnterAnim="@anim/fade_in"
            app:popExitAnim="@anim/fade_out"/>

    </fragment>

    <!-- SETTING -->
    <fragment
        android:id="@+id/settingFragment"
        android:name="com.example.navigationdrawer.SettingFragment"
        android:label="Setting"/>

    <!-- DETAIL PROFILE -->
    <fragment
        android:id="@+id/detailProfileFragment"
        android:name="com.example.navigationdrawer.DetailProfileFragment"
        android:label="Detail Profile">

        <argument
            android:name="dataSatu"
            app:argType="string"
            android:defaultValue=""/>

    </fragment>

</navigation>
